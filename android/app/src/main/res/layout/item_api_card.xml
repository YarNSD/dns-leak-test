<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardApi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Name, Select/Active Badge & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvApiName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="edns.ip-api.com" />

            <TextView
                android:id="@+id/tvApiStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/badge_neutral_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="НЕ ПРОВЕРЕН"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvApiBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_neutral_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="ВЫБРАТЬ"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- URL / Endpoint -->
        <TextView
            android:id="@+id/tvApiUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            tools:text="https://edns.ip-api.com/json" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvApiDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            tools:text="Быстрый анализ клиентской подсети EDNS и внешних резолверов" />

        <!-- Method Details -->
        <TextView
            android:id="@+id/tvApiMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            tools:text="Механика: Однократный запрос к edns.ip-api.com" />

        <!-- RU Availability -->
        <TextView
            android:id="@+id/tvApiRuAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            tools:text="Доступность в РФ: Отличная (прямой доступ)" />

        <!-- Latency / Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvApiLatency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Задержка: 145 ms"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressApiItem"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
