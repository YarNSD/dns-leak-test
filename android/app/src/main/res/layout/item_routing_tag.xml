<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_chip_squircle"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvTagBadgeType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_neutral_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="GEOSITE"
        android:textColor="@color/accent_cyan"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTagValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:text="geosite:google"
        android:textColor="@color/on_surface"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/btnCopyTag"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:srcCompat="@drawable/ic_copy"
        app:tint="@color/on_surface_variant" />
</LinearLayout>
